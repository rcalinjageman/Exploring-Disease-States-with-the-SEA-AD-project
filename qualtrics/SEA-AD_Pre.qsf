{"SurveyEntry":{"SurveyID":"SV_8oyr0wqbFHJq0xE","SurveyName":"SEA-AD Pre","SurveyDescription":null,"SurveyOwnerID":"UR_55cHjOPY8o3aX9H","SurveyBrandID":"dom","DivisionID":null,"SurveyLanguage":"EN","SurveyActiveResponseSet":"RS_eA8L3kFGoVshywC","SurveyStatus":"Active","SurveyStartDate":"0000-00-00 00:00:00","SurveyExpirationDate":"0000-00-00 00:00:00","SurveyCreationDate":"2025-09-24 20:34:51","CreatorID":"UR_55cHjOPY8o3aX9H","LastModified":"2026-07-07 09:52:36","LastAccessed":"0000-00-00 00:00:00","LastActivated":"2025-09-24 20:52:56","Deleted":null},"SurveyElements":[{"SurveyID":"SV_8oyr0wqbFHJq0xE","Element":"BL","PrimaryAttribute":"Survey Blocks","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":[{"Type":"Default","Description":"Default Question Block","ID":"BL_d4oFwaa7zfK7bdI","BlockElements":[{"Type":"Question","QuestionID":"QID1","SkipLogic":[{"SkipLogicID":1,"ChoiceLocator":"q:\/\/QID1\/SelectableChoice\/2","Condition":"Selected","SkipToDestination":"ENDOFSURVEY","Locator":"q:\/\/QID1\/SelectableChoice\/2","SkipToDescription":"You are being asked to part... <strong>I decline participation and...<\/strong>  <strong>Is Selected<\/strong>","Description":"Condition: <strong title=\"I decline participation and\/or I am not yet 18 years old\">I decline participation and...<\/strong> <strong>Is Selected<\/strong>. Skip To: <strong>End of Survey<\/strong>.","QuestionID":"QID1"}]}]},{"Type":"Trash","Description":"Trash \/ Unused Questions","ID":"BL_7PBzeRONKMtSxZs","BlockElements":[]},{"Type":"Standard","SubType":"","Description":"Attitudes","ID":"BL_9YV3uUX7G85bIZo","BlockElements":[{"Type":"Question","QuestionID":"QID13"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID3"},{"Type":"Page Break"},{"Type":"Question","QuestionID":"QID2"}]},{"Type":"Standard","SubType":"","Description":"Objective","ID":"BL_8vNq0zI9VPulram","BlockElements":[{"Type":"Question","QuestionID":"QID4"},{"Type":"Question","QuestionID":"QID5"},{"Type":"Question","QuestionID"